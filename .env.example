# Flowix env — copy to .env and fill
# Postgres
DATABASE_URL=postgres://flowix:flowix@localhost:5432/flowix?sslmode=disable
POSTGRES_USER=flowix
POSTGRES_PASSWORD=flowix
POSTGRES_DB=flowix

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
VIDEO_STORAGE_BUCKET=videos

# RabbitMQ
RABBITMQ_URL=amqp://flowix:flowix@localhost:5672/
RABBITMQ_DEFAULT_USER=flowix
RABBITMQ_DEFAULT_PASS=flowix

# Auth
JWT_SECRET=change-me-super-secret-jwt-key-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Internal services (metadata / internal/*) — shared secret for gateway/nginx/transcoder → metadata
INTERNAL_TOKEN=change-me-internal-token-32chars
# Upload limit (bytes). 5GB default for Phase 9, Phase 11 will use presigned multipart for bigger files
UPLOAD_MAX_BYTES=5368709120

# Transcoder (Phase 10) — limit CPU/RAM per job, sequential renditions
FFMPEG_THREADS=2
FFMPEG_PRESET=veryfast
# Phase 12: adaptive ladder + HW + pipe streaming
ENCODE_MODE=cbr
FFMPEG_HWACCEL=auto
TRANSCODER_PIPE_INPUT=true
# Phase 15 cost: delete raw/{id}/original.mp4 after ready unless true; lifecycle 7d via mc ilm is safety net
KEEP_RAW=false
# Phase 15: set DATABASE_URL to pgbouncer to enable pooled connections (transaction mode, statement_cache_size=0)
# DATABASE_URL=postgres://flowix:flowix@pgbouncer:6432/flowix?sslmode=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
PGBOUNCER_ENABLED=false

# Services ports (infra)
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=100
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO public endpoint for presigned URLs (Phase 11) — browser uses localhost:9000, internal uses minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_API_CORS_ALLOW_ORIGIN=*

# App ports
GATEWAY_PORT=8080
AUTH_PORT=8001
METADATA_PORT=8002
UPLOAD_PORT=8003
NGINX_VOD_PORT=8081
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
TRANSCODER_METRICS_PORT=8004
LOKI_PORT=3100
